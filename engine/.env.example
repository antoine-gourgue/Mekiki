# Copy this file to .env (git ignores it) and fill in the values.
# Variables already set in the environment win over this file.
# In development the engine reads engine/.env; the installed app reads the .env next to its
# database (%APPDATA%\io.github.antoine-gourgue.mekiki on Windows,
# ~/Library/Application Support/io.github.antoine-gourgue.mekiki on macOS).

# eBay developer application, for live eBay prices in "Prix en Europe".
# developer.ebay.com > Application Keysets > Production: App ID and Cert ID.
MEKIKI_EBAY_CLIENT_ID=
MEKIKI_EBAY_CLIENT_SECRET=
# MEKIKI_EBAY_MARKETPLACE=EBAY_FR
